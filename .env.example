# Server-only. Do not commit real secrets.

# Postgres connection string (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pocket_circle?sslmode=require

# JWT signing secret (required in production)
JWT_SECRET=change-me

# Public origin of the Next.js app — used in invite and password-reset links
FRONTEND_URL=http://localhost:3000

# HTTP port (default 4001)
PORT=4001

# Paystack secret — Nigerian bank list + NUBAN resolve at signup
PAYSTACK_SECRET_KEY=

# Cloudinary — receipt uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — invite and password-reset emails
# Demo mode is ON unless RESEND_DEMO_MODE=false. In demo mode the API still
# returns the full email payload (to, subject, body) so the UI can display and
# copy it. Resend test/sandbox keys can only send to the account owner's
# verified address; other recipients will not receive mail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pocket Circle <onboarding@resend.dev>
RESEND_DEMO_MODE=true
